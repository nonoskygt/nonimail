<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed because Ollama usually listens on plain http inside the user's LAN.
     IMAP uses its own sockets (TLS by default) and is not affected by this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
